{
  "name": "phoenix-nextjs",
  "version": "1.22.0",
  "description": "Phoenix Dashboard & WebApp Template (Next.js)",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:next": "next lint",
    "convert:pages": "node scripts/convert-pages.mjs",
    "convert:shell": "node scripts/convert-pages.mjs --shell-only",
    "dev:watch": "nodemon --watch public --watch src --ext html,pug,scss,js --exec \"npm run convert:shell\"",
    "fix:forms": "node scripts/fix-react-forms.mjs",
    "fix:tables": "node scripts/fix-table-hydration.mjs",
    "fix:jsx": "node scripts/fix-react-jsx.mjs",
    "fix:code-samples": "node scripts/fix-code-sample-strings.mjs",
    "dev:gulp": "gulp",
    "build:gulp": "cross-env MODE=PROD gulp build",
    "start:prod": "cross-env MODE=PROD gulp",
    "build:test": "cross-env MODE=PROD gulp build:test",
    "live": "gulp compile:all && cross-env MODE=PROD gulp live",
    "publish": "gh-pages -d live",
    "publish:force": "cross-var git push origin `git subtree split --prefix live $npm_package_version`:gh-pages --force",
    "publish:f": "git push origin `git subtree split --prefix live main`:gh-pages --force",
    "localhost": "ssh -R 80:localhost:3000 ssh.localhost.run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
